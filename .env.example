# ── Despliegue Docker (docker-compose). Copia a `.env` y ajusta. ──────────

# Etiqueta de las imágenes (alucard/backend, alucard/frontend)
ALUCARD_TAG=latest

# Puertos publicados en el host
BACKEND_PORT=7331
FRONTEND_PORT=7330

# ── Credenciales IGDB ("GamesDb"), opcionales ─────────────────
# También pueden inyectarse vía backend/.env con los nombres IGDB_CLIENT_ID /
# IGDB_CLIENT_SECRET (ver scripts/bootstrap_env.py). El backend acepta ambos nombres.
ALUCARD_IGDB_CLIENT_ID=
ALUCARD_IGDB_CLIENT_SECRET=
