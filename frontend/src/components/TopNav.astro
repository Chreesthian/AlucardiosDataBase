---
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;

const link = (active: boolean) =>
  active
    ? "text-zinc-100 font-semibold"
    : "text-zinc-400 hover:text-zinc-100 transition-colors";
---

<header class="sticky top-0 z-20 border-b border-zinc-800/70 bg-zinc-950/85 backdrop-blur">
  <nav class="mx-auto flex w-full max-w-7xl items-center gap-6 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label="Alucardio — inicio">
      <img
        src="/brand/logo.png"
        alt="Alucardio"
        class="h-9 w-auto select-none sm:h-10"
        width={640}
        height={220}
      />
    </a>
    <div class="flex items-center gap-5 text-sm">
      <a href="/" class={link(pathname === "/" || pathname.startsWith("/game/"))}>
        Biblioteca
      </a>
    </div>
  </nav>
</header>
