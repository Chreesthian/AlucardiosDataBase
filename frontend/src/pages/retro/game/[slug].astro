---
import Base from "../../../layouts/Base.astro";
import FichaIGDB from "../../../components/FichaIGDB.astro";
import { api, type FileOut, type TitleDetailOut } from "../../../lib/api";
import { formatBytes } from "../../../lib/format";

// Ficha de un juego de la colección RETRO. La cabecera y TODA la ficha IGDB
// (artwork, carátula, nombre canónico, ratings, sinopsis, ficha técnica, vídeos,
// capturas, similares y el enlace a IGDB) las pinta el MISMO componente que la
// ficha del catálogo de Switch: las dos secciones se ven exactamente igual.
// Lo propio de esta colección es el SISTEMA, que entra por el slot `badge` con su
// NOMBRE OFICIAL (de `app.plataformas`; el código del volcado, `ARC N-64`, es la
// identidad del contenido en MEGA y no se enseña), y el contenido, que aquí no
// lleva descargas MEGA (la sesión activa de MEGAcmd es la de la biblioteca).
const slug = Astro.params.slug ?? "";
let detalle: TitleDetailOut | null = null;
let error: string | null = null;
try {
  detalle = await api.retroTitle(slug);
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  // El juego no existe en la colección retro → 404 de verdad.
  if (error.includes("404")) {
    Astro.response.status = 404;
  }
}

// Plataforma oficial del juego (con respaldo al código si el backend es antiguo).
const sistema = detalle?.plataforma?.nombre ?? detalle?.letter ?? "";
const sistemaClave = detalle?.plataforma?.clave ?? detalle?.letter ?? "";
// Cabecera: manda el NOMBRE OFICIAL de IGDB (con su año); el fichero ROM real es
// la identidad del contenido en MEGA y se ve en la propia ficha.
const nombre = detalle?.igdb_name ?? detalle?.name ?? slug;
const anio = detalle?.igdb_year ?? null;
const archivos = (items: FileOut[]) => items.reduce((n, f) => n + f.size, 0);
---

<Base
  title={nombre}
  description={`${nombre}${anio ? ` (${anio})` : ""} — ROM retro (${sistema || "sistema desconocido"})`}
>
  {error ? (
    <section class="mt-10 rounded-2xl border border-red-200 bg-red-50 p-8 text-center">
      <h2 class="text-lg font-semibold text-red-700">No se pudo cargar el juego retro</h2>
      <p class="mt-2 text-sm text-red-500">{error}</p>
      <a href="/retro/" class="mt-4 inline-block text-sm text-emerald-400 hover:underline">← Volver a Retro</a>
    </section>
  ) : detalle ? (
    <>
      <a href="/retro/" class="text-sm text-zinc-400 hover:text-zinc-200">← Retro</a>

      <FichaIGDB detail={detalle} ficha={detalle.ficha ?? null} priorizarCanonico>
        <span slot="badge" class="flex shrink-0 items-center gap-2">
          {sistema ? (
            <a
              href={`/retro/?sistema=${encodeURIComponent(sistemaClave)}`}
              title={`Ver todos los juegos de ${sistema}`}
              class="rounded-lg bg-emerald-500/15 px-2.5 py-1 text-xs font-semibold text-emerald-300 hover:bg-emerald-500/25"
            >{sistema}</a>
          ) : null}
          {anio ? (
            <a
              href="/retro/?sort=year"
              title="Ordenar la colección por época (año de lanzamiento)"
              class="rounded-lg bg-zinc-800 px-2.5 py-1 text-xs font-semibold text-zinc-300 hover:bg-zinc-700"
            >{anio}</a>
          ) : null}
        </span>

        <Fragment slot="contenido">
          <section class="mt-8 rounded-xl border border-zinc-800/70 bg-zinc-900/30 p-5">
            <header class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="text-base font-semibold text-zinc-100">Contenido</h2>
              <span class="text-xs text-zinc-500">
                {formatBytes(detalle.size_bytes)} · {detalle.file_count} archivos{detalle.folder_count > 0 ? ` · ${detalle.folder_count} carpetas` : ""}
              </span>
            </header>
            {detalle.versions.length > 0 ? (
              <div class="mt-4 space-y-4">
                {detalle.versions.map((v) => (
                  <div class="rounded-xl border border-zinc-800/70 bg-zinc-900/40 p-4">
                    <header class="flex flex-wrap items-baseline justify-between gap-2">
                      <h3 class="text-sm font-semibold text-zinc-100">{v.name}</h3>
                      <span class="text-xs text-zinc-500">
                        {v.file_count} archivos · {formatBytes(v.size_bytes)}
                      </span>
                    </header>
                    <ul class="mt-3 divide-y divide-zinc-800/60">
                      {v.files.map((f) => (
                        <li class="flex items-center justify-between gap-4 py-2 text-sm">
                          <span class="min-w-0 truncate text-zinc-200" title={f.path}>{f.name}</span>
                          <span class="shrink-0 text-xs text-zinc-500">{formatBytes(f.size)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ) : (
              <>
                {detalle.remaining_files.length === 1 ? (
                  <p class="mt-2 text-xs text-zinc-500">
                    Este juego es un único archivo ({formatBytes(archivos(detalle.remaining_files))}).
                  </p>
                ) : null}
                <ul class="mt-3 divide-y divide-zinc-800/60">
                  {detalle.remaining_files.map((f) => (
                    <li class="flex items-center justify-between gap-4 py-2 text-sm">
                      <span class="min-w-0 truncate text-zinc-200" title={f.path}>{f.name}</span>
                      <span class="shrink-0 text-xs text-zinc-500">{formatBytes(f.size)}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        </Fragment>
      </FichaIGDB>
    </>
  ) : null}
</Base>
