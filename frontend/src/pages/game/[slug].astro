---
import Base from "../../layouts/Base.astro";
import FichaIGDB from "../../components/FichaIGDB.astro";
import { api, type TitleDetailOut } from "../../lib/api";
import { formatBytes } from "../../lib/format";

const slug = Astro.params.slug ?? "";
let detail: TitleDetailOut | null = null;
let error: string | null = null;
try {
  detail = await api.title(slug);
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  // El título no existe en la biblioteca → HTTP 404 de verdad.
  if (error.includes("404")) {
    Astro.response.status = 404;
  }
}

const labelMap: Record<string, { text: string; cls: string }> = {
  base: { text: "Base", cls: "bg-sky-100 text-sky-700" },
  update: { text: "Actualización", cls: "bg-emerald-100 text-emerald-700" },
  dlc: { text: "DLC", cls: "bg-amber-100 text-amber-700" },
  other: { text: "Otro", cls: "bg-[#ECECEC] text-zinc-600" },
};

// Nombres legibles de versión: en MEGA las carpetas se llaman "B-ASE" y
// "U-PD x.y"; en la UI se muestran como "VERSIÓN BASE" y "ACTUALIZACIÓN",
// conservando el número de versión de la actualización cuando existe.
const TITULO_VERSION: Record<string, string> = {
  base: "VERSIÓN BASE",
  update: "ACTUALIZACIÓN",
};
function tituloVersion(v: { label: string; name: string }): string {
  if (v.label !== "update") return TITULO_VERSION[v.label] ?? v.name;
  const numero = v.name.match(/\d+(?:\.\d+)+/);
  return numero ? `ACTUALIZACIÓN ${numero[0]}` : TITULO_VERSION.update;
}

// La ficha IGDB (artwork, carátula, ratings, sinopsis, ficha técnica, vídeos,
// capturas, similares y el enlace a IGDB) la pinta el componente COMPARTIDO con
// la colección retro: así las dos secciones se ven EXACTAMENTE igual.
const ficha = detail?.ficha ?? null;
// Badge de la ficha: la PLATAFORMA oficial (el bucket A-Z del volcado se llama
// igual en el catálogo de Switch, así que `letter` solo queda como respaldo).
const plataforma = detail?.plataforma?.nombre ?? detail?.letter ?? "";
---

<Base title={detail?.name ?? slug} description={`Detalle de ${detail?.name ?? slug}`}>
  {error ? (
    <section class="mt-10 rounded-2xl border border-red-200 bg-red-50 p-8 text-center">
      <h2 class="text-lg font-semibold text-red-700">No se pudo cargar el juego</h2>
      <p class="mt-2 text-sm text-red-500">{error}</p>
      <a href="/" class="mt-4 inline-block text-sm text-blue-600 hover:underline">← Volver a la biblioteca</a>
    </section>
  ) : detail ? (
    <>
      <a href="/" class="text-sm text-zinc-400 hover:text-zinc-200">← Biblioteca</a>


      <FichaIGDB detail={detail} ficha={ficha}>
        <span slot="badge" class="shrink-0 rounded-lg border border-zinc-200 bg-white px-2.5 py-1 text-xs font-bold text-zinc-600">{plataforma}</span>
        <Fragment slot="contenido">
    <h2 class="mt-8 text-xl font-semibold text-zinc-100">Versiones</h2>
    <div class="mt-3 flex flex-col gap-3">
      {detail.versions.length === 0 && detail.remaining_files.length === 0 && (
        <p class="text-sm text-zinc-500">Sin contenido listado en este título.</p>
      )}
      {detail.versions.map((v) => {
        const l = labelMap[v.label] ?? labelMap.other;
        const esBaseOUpdate = v.label === "base" || v.label === "update";
        return (
          <details open={v.label === "base"} class="group rounded-xl border border-zinc-800/80 bg-zinc-900/40">
            <summary class="flex cursor-pointer select-none flex-wrap items-center gap-3 px-4 py-3">
              {!esBaseOUpdate && (
                <span class={`rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide ${l.cls}`}>{l.text}</span>
              )}
              <span class="font-medium text-zinc-100">{esBaseOUpdate ? tituloVersion(v) : v.name}</span>
              <span class="ml-auto text-xs text-zinc-500">
                {formatBytes(v.size_bytes)} · {v.file_count} archivos{v.folder_count > 0 && ` · ${v.folder_count} carpetas`}
              </span>
              <a href="#" data-download={v.full_path}
                 class="shrink-0 rounded-md bg-zinc-800 px-2 py-1 text-xs text-zinc-300 hover:bg-blue-600 hover:text-white"
                 title="Descargar esta carpeta desde MEGA">⬇ carpeta</a>
            </summary>
            <ul class="border-t border-zinc-800/60 px-4 py-2">
              {v.files.length === 0 && <li class="py-2 text-xs text-zinc-600">(solo carpetas)</li>}
              {v.files.map((f) => (
                <li class="flex items-center gap-3 border-b border-zinc-800/40 py-2 last:border-0">
                  <span class="w-16 shrink-0 text-right font-mono text-[10px] uppercase text-zinc-500">{f.ext ?? "—"}</span>
                  <span class="min-w-0 truncate font-mono text-xs text-zinc-300" title={f.name}>{f.name}</span>
                  <span class="ml-auto shrink-0 text-xs text-zinc-500">{formatBytes(f.size)}</span>
                  <a href="#" data-download={f.full_path}
                     class="shrink-0 rounded-md bg-zinc-800 px-2 py-1 text-xs text-zinc-300 hover:bg-blue-600 hover:text-white"
                     title="Descargar desde MEGA">⬇</a>
                </li>
              ))}
            </ul>
          </details>
        );
      })}
    </div>

    {detail.remaining_files.length > 0 && (
      <>
        <h2 class="mt-8 text-xl font-semibold text-zinc-100">Archivos sueltos</h2>
        <ul class="mt-3 rounded-xl border border-zinc-800/80 bg-zinc-900/40 px-4">
          {detail.remaining_files.map((f) => (
            <li class="flex items-center gap-3 border-b border-zinc-800/40 py-2 last:border-0">
              <span class="min-w-0 truncate font-mono text-xs text-zinc-300">{f.name}</span>
              <span class="ml-auto shrink-0 text-xs text-zinc-500">{formatBytes(f.size)}</span>
              <a href="#" data-download={f.full_path}
                 class="shrink-0 rounded-md bg-zinc-800 px-2 py-1 text-xs text-zinc-300 hover:bg-blue-600 hover:text-white"
                 title="Descargar desde MEGA">⬇</a>
            </li>
          ))}
        </ul>
      </>
    )}
        </Fragment>
      </FichaIGDB>
    </>
  ) : null}
</Base>

<script is:inline>
  // Descarga: clic en ⬇ → /api/download?path=… (enlace público MEGA o sitio MEGA).
  document.addEventListener("click", (e) => {
    const el = (e.target).closest("[data-download]");
    if (!el) return;
    e.preventDefault();
    const api = window.__ALUCARD_API || "http://localhost:7331";
    const p = el.getAttribute("data-download");
    if (!p) return;
    window.location.href = `${api}/api/download?path=${encodeURIComponent(p)}`;
  });
</script>
