---
import Base from "../../layouts/Base.astro";
import { api, type TitleDetailOut } from "../../lib/api";
import { formatBytes, initials } from "../../lib/format";

const slug = Astro.params.slug ?? "";
let detail: TitleDetailOut | null = null;
let error: string | null = null;
try {
  detail = await api.title(slug);
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  // El título no existe en la biblioteca → HTTP 404 de verdad.
  if (error.includes("404")) {
    Astro.response.status = 404;
  }
}

function etiquetaUrl(url: string): string {
  const marcas: [string, string][] = [
    ["store.steampowered.com", "Steam"], ["steamcommunity.com", "Steam"],
    ["gog.com", "GOG"], ["xbox.com", "Xbox"], ["microsoft.com", "Microsoft"],
    ["playstation.com", "PlayStation"], ["nintendo.com", "Nintendo"],
    ["nintendo.es", "Nintendo"], ["epicgames.com", "Epic Games"],
    ["twitch.tv", "Twitch"], ["youtube.com", "YouTube"],
    ["discord.com", "Discord"], ["reddit.com", "Reddit"],
    ["wikipedia.org", "Wikipedia"], ["play.google.com", "Google Play"],
    ["apps.apple.com", "App Store"], ["facebook.com", "Facebook"],
    ["x.com", "X (Twitter)"], ["twitter.com", "Twitter"],
  ];
  try {
    const host = new URL(url).hostname.toLowerCase().replace(/^www\./, "");
    for (const [marca, etiqueta] of marcas) {
      if (host.includes(marca)) return etiqueta;
    }
    return host || url;
  } catch {
    return url.slice(0, 24);
  }
}

const STAR_PATH =
  "M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z";

function aCinco(v?: number | null): number | null {
  if (v === null || v === undefined) return null;
  return Math.round((v / 20) * 10) / 10;
}

function fechaLegible(iso?: string | null): string {
  if (!iso) return "";
  const d = new Date(iso.length === 10 ? `${iso}T00:00:00Z` : iso);
  if (Number.isNaN(d.getTime())) return iso;
  try {
    return d.toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" });
  } catch {
    return iso;
  }
}

const labelMap: Record<string, { text: string; cls: string }> = {
  base: { text: "Base", cls: "bg-sky-100 text-sky-700" },
  update: { text: "Actualización", cls: "bg-emerald-100 text-emerald-700" },
  dlc: { text: "DLC", cls: "bg-amber-100 text-amber-700" },
  other: { text: "Otro", cls: "bg-[#ECECEC] text-zinc-600" },
};

const ficha = detail?.ficha ?? null;
function filaTecnica(clave: string, etiqueta: string): string[] | null {
  const v = (ficha as any)?.[clave];
  if (v === undefined || v === null) return null;
  if (Array.isArray(v) && v.length === 0) return null;
  const texto = Array.isArray(v) ? v.join(", ") : String(v);
  return texto ? [etiqueta, texto] : null;
}
const techRows = [
  filaTecnica("desarrollador", "Desarrollador"),
  filaTecnica("publicador", "Editor"),
  filaTecnica("fecha_lanzamiento", "Lanzamiento"),
  filaTecnica("plataformas", "Plataformas"),
  filaTecnica("generos", "Géneros"),
  filaTecnica("temas", "Temas"),
  filaTecnica("modos", "Modos"),
  filaTecnica("perspectivas", "Perspectiva"),
  filaTecnica("coleccion", "Colección"),
  filaTecnica("franquicia", "Franquicia"),
  filaTecnica("palabras_clave", "Palabras clave"),
].filter(Boolean) as string[][];
---

<Base title={detail?.name ?? slug} description={`Detalle de ${detail?.name ?? slug}`}>
  {error ? (
    <section class="mt-10 rounded-2xl border border-red-200 bg-red-50 p-8 text-center">
      <h2 class="text-lg font-semibold text-red-700">No se pudo cargar el juego</h2>
      <p class="mt-2 text-sm text-red-500">{error}</p>
      <a href="/" class="mt-4 inline-block text-sm text-blue-600 hover:underline">← Volver a la biblioteca</a>
    </section>
  ) : detail ? (
    <>
      <a href="/" class="text-sm text-zinc-400 hover:text-zinc-200">← Biblioteca</a>

      {/* Artwork hero real de IGDB (t_1080p) a sangre completa: full-width, sin bordes */}
      <div class="relative left-1/2 h-64 w-screen -translate-x-1/2 overflow-hidden sm:h-80 md:h-[28rem]">
        <img
          src={((ficha as any)?.hero_imagen) || ficha?.capturas?.[0] || detail.igdb_cover || ""}
          alt={`Arte de ${detail.name}`}
          loading="eager"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>

      {/* Panel de datos: fondo TRANSPARENTE (sin tarjeta blanca) */}
      <div class="relative mt-6">
        <div class="relative flex flex-col gap-6 p-5 sm:p-7 md:flex-row">
          <div class="relative aspect-[2/3] w-40 shrink-0 self-start overflow-hidden rounded-xl bg-gradient-to-br from-blue-600/80 to-indigo-950 shadow-lg sm:w-48">
            <div class="flex h-full w-full items-center justify-center">
              <span class="text-5xl font-black text-white/80">{initials(detail.name)}</span>
            </div>
            {detail.igdb_cover && (
              <img
                src={detail.igdb_cover}
                alt={detail.name}
                loading="eager"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
                onerror="this.style.display='none'"
              />
            )}
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
              <div class="min-w-0">
                <h1 class="text-3xl font-semibold tracking-tight text-zinc-100 sm:text-4xl">{detail.name}</h1>
                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-zinc-500">
                  {ficha?.fecha_lanzamiento && (
                    <span class="inline-flex items-center gap-1.5">
                      <span class="font-medium text-zinc-400">Lanzamiento</span>
                      {fechaLegible(ficha.fecha_lanzamiento)}
                    </span>
                  )}
                  {ficha?.desarrollador && (
                    <span class="inline-flex items-center gap-1.5">
                      <span class="font-medium text-zinc-400">Desarrolla</span>
                      <span class="text-zinc-300">{ficha.desarrollador}</span>
                    </span>
                  )}
                  {ficha?.publicador && ficha.publicador !== ficha.desarrollador && (
                    <span class="inline-flex items-center gap-1.5">
                      <span class="font-medium text-zinc-400">Publica</span>
                      <span class="text-zinc-300">{ficha.publicador}</span>
                    </span>
                  )}
                </div>
              </div>
              <span class="shrink-0 rounded-lg border border-zinc-200 bg-white px-2.5 py-1 text-xs font-bold text-zinc-600">{detail.letter}</span>
            </div>

            {(ficha && (ficha.rating != null || ficha.rating_agregado != null)) && (
              <div class="mt-5 flex flex-wrap gap-7">
                {ficha.rating != null && (
                  <div class="flex items-center gap-2.5">
                    <svg viewBox="0 0 576 512" aria-hidden="true" focusable="false" class="h-9 w-9 shrink-0" style="color: #ffe066">
                      <path fill="currentColor" d={STAR_PATH} />
                    </svg>
                    <div>
                      <div class="text-2xl font-black leading-none text-zinc-100">{aCinco(ficha.rating)}</div>
                      <div class="mt-0.5 text-xs text-zinc-500">{ficha.votos ?? 0} valoraciones de usuarios</div>
                    </div>
                  </div>
                )}
                {ficha.rating_agregado != null && (
                  <div class="flex items-center gap-2.5">
                    <svg viewBox="0 0 576 512" aria-hidden="true" focusable="false" class="h-6 w-6 shrink-0" style="color: #ffe066">
                      <path fill="currentColor" d={STAR_PATH} />
                    </svg>
                    <div>
                      <div class="text-xl font-black leading-none text-zinc-100">{aCinco(ficha.rating_agregado)}</div>
                      <div class="mt-0.5 text-xs text-zinc-500">valoración de críticos</div>
                    </div>
                  </div>
                )}
              </div>
            )}

            {ficha && (ficha.clasificaciones?.length || ficha.pegi) ? (
              <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
                {ficha.pegi && <span class="rounded-md bg-yellow-100 px-2 py-1 font-semibold text-yellow-700">{ficha.pegi}</span>}
                {(ficha.clasificaciones ?? [])
                  .filter((c: any) => !ficha.pegi || c.texto !== ficha.pegi)
                  .map((c: any) => (
                    <span key={`${c.sistema}-${c.texto}`} class="rounded-md bg-[#ECECEC] px-2 py-1 font-semibold text-zinc-600">{c.texto || c.sistema}</span>
                  ))}
              </div>
            ) : null}

            {(detail.formats?.length ?? 0) > 0 && (
              <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
                {detail.formats.map((f) => (
                  <span key={f} class="rounded-md bg-[#EAF4FF] px-2 py-1 font-semibold text-[#1A6FB5]">{f}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      {
        ficha && (
          <>
            <section class="mt-8 max-w-3xl">
              {ficha.descripcion && (
                <div class="mt-5">
                  <h2 class="text-lg font-semibold text-zinc-100">Sinopsis</h2>
                  <p class="mt-2 text-sm leading-relaxed text-zinc-300">{ficha.descripcion}</p>
                </div>
              )}
              {ficha.argumento && (
                <div class="mt-5">
                  <h2 class="text-lg font-semibold text-zinc-100">Argumento</h2>
                  <p class="mt-2 text-sm leading-relaxed text-zinc-400">{ficha.argumento}</p>
                </div>
              )}
            </section>

            {
              (() => {
                const fx = ficha as any;
                const hayExtra = fx?.lanzamientos?.length || fx?.enlaces?.length ||
                  fx?.idiomas_soporte?.length || fx?.clasificaciones?.length;
                if (!hayExtra) return null;
                return (
                  <div class="mt-8 grid gap-6 lg:grid-cols-2">
                    {fx?.clasificaciones?.length ? (
                      <div class="rounded-xl border border-zinc-200 bg-white p-5">
                        <h2 class="text-base font-semibold text-zinc-100">Clasificación por edad</h2>
                        <div class="mt-3 flex flex-wrap gap-2 text-xs">
                          {fx.clasificaciones.map((c: any) => (
                            <span key={c.sistema} class="rounded-md bg-[#EAF4FF] px-2 py-1 font-semibold text-[#1A6FB5]">{c.texto || c.sistema}</span>
                          ))}
                        </div>
                      </div>
                    ) : null}
                    {fx?.lanzamientos?.length ? (
                      <div class="rounded-xl border border-zinc-200 bg-white p-5">
                        <h2 class="text-base font-semibold text-zinc-100">Lanzamientos</h2>
                        <ul class="mt-3 max-h-72 divide-y divide-[#E5E5E5] overflow-auto text-sm">
                          {fx.lanzamientos.map((l: any, i: number) => (
                            <li key={i} class="flex items-center justify-between gap-3 py-1.5">
                              <span class="font-medium text-zinc-200">{l.plataforma}</span>
                              <span class="text-right text-zinc-500">{l.humano || l.fecha}{l.region ? ` · ${l.region}` : ""}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : null}
                    {fx?.idiomas_soporte?.length ? (
                      <div class="rounded-xl border border-zinc-200 bg-white p-5">
                        <h2 class="text-base font-semibold text-zinc-100">Idiomas soportados</h2>
                        <div class="mt-3 flex flex-wrap gap-2 text-xs">
                          {fx.idiomas_soporte.map((n: string) => (
                            <span key={n} class="rounded-md bg-[#EFEFEF] px-2 py-1 text-zinc-600">{n}</span>
                          ))}
                        </div>
                      </div>
                    ) : null}
                    {fx?.enlaces?.length ? (
                      <div class="rounded-xl border border-zinc-200 bg-white p-5">
                        <h2 class="text-base font-semibold text-zinc-100">Enlaces</h2>
                        <div class="mt-3 flex max-h-72 flex-wrap gap-2 overflow-auto text-xs">
                          {fx.enlaces.map((e: any, i: number) => (
                            <a key={i} href={e.url} target="_blank" rel="noreferrer" class="rounded-md bg-blue-50 px-2 py-1 font-medium text-blue-700 hover:bg-blue-100">{e.etiqueta} ↗</a>
                          ))}
                        </div>
                      </div>
                    ) : null}
                  </div>
                );
              })()
            }

            <div class="mt-8 grid gap-6 lg:grid-cols-2">
              <div class="rounded-xl border border-zinc-800/70 bg-zinc-900/30 p-5">
                <h2 class="text-base font-semibold text-zinc-100">Ficha técnica</h2>
                <dl class="mt-3 grid grid-cols-[minmax(0,9rem)_1fr] gap-x-4 gap-y-2 text-sm">
                  {techRows.map(([k, v]) => (
                    <>
                      <dt class="text-zinc-500">{k}</dt>
                      <dd class="text-zinc-200">{v}</dd>
                    </>
                  ))}
                </dl>
                <div class="mt-4 flex flex-wrap gap-2 text-xs">
                  {ficha.url_igdb && (
                    <a href={ficha.url_igdb} target="_blank" rel="noreferrer" class="rounded-lg bg-blue-600 px-3 py-1.5 font-medium text-white hover:bg-blue-500">Ver en IGDB ↗</a>
                  )}
                  {(ficha.webs ?? []).slice(0, 6).map((w: any) => (
                    <a key={w.url} href={w.url} target="_blank" rel="noreferrer" title={w.url}
                       class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-zinc-600 hover:border-zinc-400 hover:text-black">{etiquetaUrl(w.url)} ↗</a>
                  ))}
                </div>
              </div>

              {(ficha.videos?.length ?? 0) > 0 && (
                <div class="rounded-xl border border-zinc-800/70 bg-zinc-900/30 p-5">
                  <h2 class="text-base font-semibold text-zinc-100">Vídeos</h2>
                  <div class="mt-3 grid gap-4">
                    {ficha.videos.slice(0, 4).map((v: any) => (
                      <div key={v.video_id}>
                        <iframe class="aspect-video w-full rounded-lg border-0" src={`https://www.youtube-nocookie.com/embed/${v.video_id}`} title={v.nombre || "Vídeo"} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        {v.nombre && <p class="mt-1 text-xs text-zinc-500">{v.nombre}</p>}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {(ficha.capturas?.length ?? 0) > 0 && (
              <section class="mt-8">
                <h2 class="text-base font-semibold text-zinc-100">Capturas de pantalla</h2>
                <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3">
                  {ficha.capturas.slice(0, 9).map((url: string, i: number) => (
                    <a key={i} href={url} target="_blank" rel="noreferrer"><img src={url} alt="Captura" loading="lazy" decoding="async" class="aspect-video w-full rounded-lg object-cover opacity-90 transition hover:opacity-100" /></a>
                  ))}
                </div>
              </section>
            )}

            {(ficha.similares?.length ?? 0) > 0 && (
              <section class="mt-8">
                <h2 class="text-base font-semibold text-zinc-100">Juegos similares</h2>
                <div class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6">
                  {ficha.similares.slice(0, 12).map((s: any) => (
                    <a key={s.slug} href={`/game/${s.slug}/`} class="group block">
                      <div class="relative aspect-[2/3] overflow-hidden rounded-lg bg-zinc-800">
                        {s.caratula && <img src={s.caratula} alt={s.nombre} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" onerror="this.style.display='none'" />}
                        <span class="absolute inset-0 flex items-end bg-gradient-to-t from-black/60 to-transparent p-2 text-xs text-white opacity-90 group-hover:opacity-100">{s.nombre}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </>
        )
      }

      <h2 class="mt-10 text-xl font-semibold text-zinc-100">Versiones</h2>
      <div class="mt-3 flex flex-col gap-3">
        {detail.versions.length === 0 && detail.remaining_files.length === 0 && (
          <p class="text-sm text-zinc-500">Sin contenido listado en este título.</p>
        )}
        {detail.versions.map((v) => {
          const l = labelMap[v.label] ?? labelMap.other;
          return (
            <details open={v.label === "base"} class="group rounded-xl border border-zinc-800/80 bg-zinc-900/40">
              <summary class="flex cursor-pointer select-none flex-wrap items-center gap-3 px-4 py-3">
                <span class={`rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide ${l.cls}`}>{l.text}</span>
                <span class="font-medium text-zinc-100">{v.name}</span>
                <span class="ml-auto text-xs text-zinc-500">
                  {formatBytes(v.size_bytes)} · {v.file_count} archivos{v.folder_count > 0 && ` · ${v.folder_count} carpetas`}
                </span>
                <a href="#" data-download={v.full_path}
                   class="shrink-0 rounded-md bg-zinc-800 px-2 py-1 text-xs text-zinc-300 hover:bg-blue-600 hover:text-white"
                   title="Descargar esta carpeta desde MEGA">⬇ carpeta</a>
              </summary>
              <ul class="border-t border-zinc-800/60 px-4 py-2">
                {v.files.length === 0 && <li class="py-2 text-xs text-zinc-600">(solo carpetas)</li>}
                {v.files.map((f) => (
                  <li class="flex items-center gap-3 border-b border-zinc-800/40 py-2 last:border-0">
                    <span class="w-16 shrink-0 text-right font-mono text-[10px] uppercase text-zinc-500">{f.ext ?? "—"}</span>
                    <span class="min-w-0 truncate font-mono text-xs text-zinc-300" title={f.name}>{f.name}</span>
                    <span class="ml-auto shrink-0 text-xs text-zinc-500">{formatBytes(f.size)}</span>
                    <a href="#" data-download={f.full_path}
                       class="shrink-0 rounded-md bg-zinc-800 px-2 py-1 text-xs text-zinc-300 hover:bg-blue-600 hover:text-white"
                       title="Descargar desde MEGA">⬇</a>
                  </li>
                ))}
              </ul>
            </details>
          );
        })}
      </div>

      {detail.remaining_files.length > 0 && (
        <>
          <h2 class="mt-8 text-xl font-semibold text-zinc-100">Archivos sueltos</h2>
          <ul class="mt-3 rounded-xl border border-zinc-800/80 bg-zinc-900/40 px-4">
            {detail.remaining_files.map((f) => (
              <li class="flex items-center gap-3 border-b border-zinc-800/40 py-2 last:border-0">
                <span class="min-w-0 truncate font-mono text-xs text-zinc-300">{f.name}</span>
                <span class="ml-auto shrink-0 text-xs text-zinc-500">{formatBytes(f.size)}</span>
                <a href="#" data-download={f.full_path}
                   class="shrink-0 rounded-md bg-zinc-800 px-2 py-1 text-xs text-zinc-300 hover:bg-blue-600 hover:text-white"
                   title="Descargar desde MEGA">⬇</a>
              </li>
            ))}
          </ul>
        </>
      )}
    </>
  ) : null}
</Base>

<script is:inline>
  // Descarga: clic en ⬇ → /api/download?path=… (enlace público MEGA o sitio MEGA).
  document.addEventListener("click", (e) => {
    const el = (e.target).closest("[data-download]");
    if (!el) return;
    e.preventDefault();
    const api = window.__ALUCARD_API || "http://localhost:7331";
    const p = el.getAttribute("data-download");
    if (!p) return;
    window.location.href = `${api}/api/download?path=${encodeURIComponent(p)}`;
  });
</script>
