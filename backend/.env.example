# AlucardiosDataBase — backend. Copia a `.env` y ajusta.
# Todas las variables usan el prefijo ALUCARD_.

# ── Datos ────────────────────────────────────────────────────
# Ruta al volcado de MEGAcmd (canon). Si se omite se busca
# <raíz del repo>/mega_cuenta_contenido_MEGAcmd.txt
ALUCARD_DUMP_PATH=../mega_cuenta_contenido_MEGAcmd.txt

# Base de datos. Por defecto SQLite en <raíz>/data/alucard.db.
# Para Postgres (futuro) usa:
# ALUCARD_DATABASE_URL=postgresql+psycopg://user:pass@localhost/alucard
# ALUCARD_DB_PATH=

# ── API ──────────────────────────────────────────────────────
ALUCARD_API_PORT=7331
ALUCARD_CORS_ORIGINS=http://localhost:7330,http://127.0.0.1:7330

# ── MEGAcmd (sync en tiempo real, fase F5) ───────────────────
# Ruta a los binarios si no están en el PATH (MEGAcmd 2.x)
ALUCARD_MEGA_LS_BIN=mega-ls
ALUCARD_MEGACMD_BIN=megacmd
ALUCARD_MEGA_TIMEOUT_S=180

# ── IGDB / GamesDb (metadatos, fase F4) ──────────────────────
# Credenciales de IGDB (Twitch). Crea un cliente en dev.twitch.tv y añade aquí
# IGDB_CLIENT_ID / IGDB_CLIENT_SECRET, o inyéctalas con el prefijo ALUCARD_IGDB_*
# desde el `.env` raíz. scripts/bootstrap_env.py permite copiarlas desde un
# `.env` anterior: python scripts/bootstrap_env.py /ruta/a/origen.env
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
